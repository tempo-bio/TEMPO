+pub fn operation_wait(wait: OperationWait) -> Result<()> {
+    let result = match wait {
+        OperationWait::WaitPid(pid) => process::wait_for_pid_to_exit(pid, Some(Duration::from_secs(60)))?,
+        OperationWait::WaitParent => process::wait_for_parent_to_exit(Some(Duration::from_secs(60)))?,
+        OperationWait::NoWait => return Ok(()),
+    };
+    match result {
+        process::WaitResult::ExitCode(_) => Ok(()),
+        process::WaitResult::WaitTimeout => anyhow::bail!("Process did not exit; update cancelled."),
+        process::WaitResult::NoWaitRequired => anyhow::bail!("Could not confirm process exit; update cancelled."),
     }
 }
 
