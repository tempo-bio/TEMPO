+/// Refuse replacement while another identifiable package process exists.
+pub fn ensure_package_stopped<P: AsRef<Path>>(root_dir: P) -> Result<()> {
+    let processes = unsafe { get_processes_running_in_directory(root_dir, false)? };
+    for (pid, path, _) in processes {
+        if pid != std::process::id() {
+            bail!("Package process is still running: {} ({})", path.display(), pid);
+        }
+    }
+    Ok(())
