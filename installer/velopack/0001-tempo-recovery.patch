+// The environment is read only by an explicitly feature-gated fixture build.
+#[cfg(feature = "tempo-fixture-faults")]
+fn fixture_fault(point: &str) -> Result<()> {
+    if std::env::var("TEMPO_FIXTURE_FAULT").map(|v| v.split(',').any(|p| p == point)).unwrap_or(false) {
+        bail!("Injected fixture fault at {}", point);
+    }
+    if std::env::var("TEMPO_FIXTURE_ABORT").ok().as_deref() == Some(point) {
+        std::process::abort();
+    }
+    Ok(())
+}
+#[cfg(not(feature = "tempo-fixture-faults"))]
