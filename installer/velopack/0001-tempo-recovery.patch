+/// Refuse linked/reparse storage, matching the companion's path policy.
+fn safe_path(path: &Path) -> Result<PathBuf> {
+    use std::os::windows::fs::MetadataExt;
+    let path = std::path::absolute(path)?;
+    for part in path.ancestors() {
+        match fs::symlink_metadata(part) {
+            Ok(m) if m.file_attributes() & 0x400 != 0 => bail!("Link/reparse point in operation storage: {:?}", part),
+            Ok(_) => (),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => (),
+            Err(e) => return Err(e.into()),
+        }
+    }
+    Ok(path)
+}
+
+fn exclusive_operation_lock(path: &Path, inherited_name: &str) -> Result<fs::File> {
+    use std::os::windows::io::{AsRawHandle, FromRawHandle};
+    use windows::Win32::{
+        Foundation::{SetHandleInformation, HANDLE, HANDLE_FLAGS, HANDLE_FLAG_INHERIT},
+        Storage::FileSystem::{GetFileInformationByHandle, BY_HANDLE_FILE_INFORMATION},
+    };
+    let path = safe_path(path)?;
+    fs::create_dir_all(path.parent().ok_or_else(|| anyhow::anyhow!("Invalid lock path"))?)?;
+    if let Some(value) = std::env::var_os(inherited_name) {
+        // Consume once; hooks, restart children and cleanup must not inherit it.
+        std::env::remove_var(inherited_name);
+        let raw: usize = value.to_str().ok_or_else(|| anyhow::anyhow!("Invalid inherited lease"))?.parse()?;
+        if raw == 0 || raw == usize::MAX {
+            bail!("Invalid inherited lease");
+        }
+        let file = unsafe { fs::File::from_raw_handle(raw as *mut std::ffi::c_void) };
+        unsafe {
+            SetHandleInformation(HANDLE(file.as_raw_handle()), HANDLE_FLAG_INHERIT.0, HANDLE_FLAGS(0))?;
+        }
+        // Attribute-only open is compatible with an exclusive read/write lease.
+        let expected = fs::OpenOptions::new().access_mode(0).share_mode(7).open(&path)?;
+        let identity = |file: &fs::File| -> Result<(u32, u32, u32)> {
+            let mut info = BY_HANDLE_FILE_INFORMATION::default();
+            unsafe {
+                GetFileInformationByHandle(HANDLE(file.as_raw_handle()), &mut info)?;
+            }
+            Ok((info.dwVolumeSerialNumber, info.nFileIndexHigh, info.nFileIndexLow))
+        };
+        if identity(&file)? != identity(&expected)? {
+            bail!("Inherited lease belongs to another installation");
+        }
+        // It must actually exclude a competing writer, not just identify a file.
+        match fs::OpenOptions::new().read(true).write(true).share_mode(7).open(&path) {
+            Err(e) if e.raw_os_error() == Some(32) => (),
+            _ => bail!("Inherited lease is not exclusive"),
+        }
+        Ok(file)
+    } else {
+        Ok(fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .share_mode(0)
+            .open(&path)?)
+    }
+}
+
+/// Acquire after the application lease, before any installation inspection/write.
+/// The pathname survives removal and is never unlinked.
+pub fn installation_lock(root: &Path) -> Result<fs::File> {
+    let root = safe_path(root)?;
+    let root = if root.exists() {
+        fs::canonicalize(root)?
+    } else {
+        let parent = root.parent().ok_or_else(|| anyhow::anyhow!("Invalid installation root"))?;
+        fs::create_dir_all(parent)?;
+        fs::canonicalize(parent)?.join(root.file_name().ok_or_else(|| anyhow::anyhow!("Invalid installation root"))?)
+    };
+    let mut filename = OsString::from(".");
+    filename.push(root.file_name().ok_or_else(|| anyhow::anyhow!("Invalid installation root"))?);
+    filename.push(".tempo-owner.lock");
+    exclusive_operation_lock(&root.parent().unwrap().join(filename), "TEMPO_INSTALLATION_LOCK_HANDLE")
+}
+
+/// Same per-user desktop/worker lifetime lease as tempo_update_lock.py.
+pub fn application_lock() -> Result<fs::File> {
+    let local = std::env::var_os("LOCALAPPDATA").ok_or_else(|| anyhow::anyhow!("LOCALAPPDATA is unavailable"))?;
